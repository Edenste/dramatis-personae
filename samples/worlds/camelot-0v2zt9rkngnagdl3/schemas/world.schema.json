{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]{16}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mainView": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]{16}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "schemaVersion",
    "mainView"
  ],
  "additionalProperties": {}
}
