{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]{16}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "object",
      "properties": {
        "calendar": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "calendar"
      ],
      "additionalProperties": {}
    },
    "repeat": {
      "type": "string",
      "enum": [
        "yearly",
        "none"
      ]
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "characters": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]{16}$"
      }
    },
    "body": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "date",
    "repeat",
    "color"
  ],
  "additionalProperties": {}
}
