{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "date",
              "colour",
              "select",
              "multiselect",
              "character",
              "measurement"
            ]
          },
          "section": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calendar": {
            "type": "object",
            "properties": {
              "show": {
                "type": "boolean"
              },
              "color": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "show",
              "color",
              "title"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "default"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": {}
}
