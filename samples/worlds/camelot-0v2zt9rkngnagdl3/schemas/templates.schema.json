{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "fields"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "templates"
  ],
  "additionalProperties": {}
}
