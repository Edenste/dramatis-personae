# Electron Forge needs its packages reachable from the workspace root (ADR 0008).
# The pnpm defaults (eslint, prettier) are listed again because setting this replaces them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=electron
public-hoist-pattern[]=@electron/*
public-hoist-pattern[]=@electron-forge/*
